  <script>
    let audioEnabled = true;
    let audioCtx = null;

    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
    }

    function playSound(type) {
      if (!audioEnabled) return;
      initAudio();
      if (audioCtx.state === 'suspended') audioCtx.resume();

      const now = audioCtx.currentTime;

      if (type === 'tap') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(523.25, now);
        osc.frequency.exponentialRampToValueAtTime(1046.50, now + 0.12);
        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.12);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.12);
      } else if (type === 'win') {
        [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now + i * 0.06);
          gain.gain.setValueAtTime(0.2, now + i * 0.06);
          gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.06 + 0.3);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now + i * 0.06);
          osc.stop(now + i * 0.06 + 0.3);
        });
      } else if (type === 'jackpot') {
        [523.25, 659.25, 783.99, 1046.50, 1318.51, 1567.98].forEach((freq, i) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(freq, now + i * 0.05);
          gain.gain.setValueAtTime(0.2, now + i * 0.05);
          gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.05 + 0.5);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now + i * 0.05);
          osc.stop(now + i * 0.05 + 0.5);
        });
      } else if (type === 'zero') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(220, now);
        osc.frequency.exponentialRampToValueAtTime(80, now + 0.3);
        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.3);
      } else if (type === 'shuffle') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(350, now);
        osc.frequency.exponentialRampToValueAtTime(900, now + 0.2);
        gain.gain.setValueAtTime(0.15, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.2);
      }
    }

    function toggleAudio(e) {
      createRipple(e);
      audioEnabled = !audioEnabled;
      document.getElementById('soundIconOn').classList.toggle('hidden', !audioEnabled);
      document.getElementById('soundIconOff').classList.toggle('hidden', audioEnabled);
    }

    function createRipple(e) {
      const btn = e.currentTarget;
      if (!btn) return;
      const rect = btn.getBoundingClientRect();
      const circle = document.createElement("span");
      const diameter = Math.max(rect.width, rect.height);
      circle.style.width = circle.style.height = `${diameter}px`;
      circle.style.left = `${e.clientX - rect.left - diameter / 2}px`;
      circle.style.top = `${e.clientY - rect.top - diameter / 2}px`;
      circle.classList.add("ripple-effect");
      btn.appendChild(circle);
      setTimeout(() => circle.remove(), 500);
    }

    let luckMode = 'normal';
    let totalVault = 0.00;
    let displayedVault = 0.00;
    let totalPicks = 0;
    let winsCount = 0;
    let jackpotsCount = 0;
    const TOTAL_STARS = 6;
    let starValues = [];
    let revealed = Array(TOTAL_STARS).fill(false);
    let history = [];

    // 6 BASIC COLOR STARS (Named Strictly By Color)
    const BASIC_STARS = [
      {
        colorName: "RED STAR",
        border: "border-red-500 group-hover:border-red-400",
        bgGlow: "bg-red-500/15 shadow-[0_0_30px_rgba(239,68,68,0.4)]",
        textBadge: "text-red-400 group-hover:text-red-300",
        faceSvg: `<svg class="w-16 h-16 filter drop-shadow-[0_0_12px_#ef4444]" viewBox="0 0 100 100">
                    <polygon points="50,5 64,36 98,36 71,57 81,91 50,70 19,91 29,57 2,36 36,36" fill="#ef4444" stroke="#fca5a5" stroke-width="2"/>
                    <circle cx="38" cy="45" r="5" fill="#000"/>
                    <circle cx="62" cy="45" r="5" fill="#000"/>
                    <circle cx="36" cy="43" r="2" fill="#fff"/>
                    <circle cx="60" cy="43" r="2" fill="#fff"/>
                    <path d="M 42 58 Q 50 68 58 58" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round"/>
                    <ellipse cx="32" cy="54" rx="4" ry="2" fill="#f87171"/>
                    <ellipse cx="68" cy="54" rx="4" ry="2" fill="#f87171"/>
                  </svg>`
      },
      {
        colorName: "BLUE STAR",
        border: "border-blue-500 group-hover:border-blue-400",
        bgGlow: "bg-blue-500/15 shadow-[0_0_30px_rgba(59,130,246,0.4)]",
        textBadge: "text-blue-400 group-hover:text-blue-300",
        faceSvg: `<svg class="w-16 h-16 filter drop-shadow-[0_0_12px_#3b82f6]" viewBox="0 0 100 100">
                    <polygon points="50,5 64,36 98,36 71,57 81,91 50,70 19,91 29,57 2,36 36,36" fill="#3b82f6" stroke="#93c5fd" stroke-width="2"/>
                    <polygon points="30,42 46,42 44,52 32,52" fill="#000"/>
                    <polygon points="54,42 70,42 68,52 56,52" fill="#000"/>
                    <line x1="46" y1="45" x2="54" y2="45" stroke="#000" stroke-width="2"/>
                    <path d="M 45 60 Q 55 62 60 56" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round"/>
                  </svg>`
      },
      {
        colorName: "YELLOW STAR",
        border: "border-yellow-400 group-hover:border-yellow-300",
        bgGlow: "bg-yellow-400/15 shadow-[0_0_30px_rgba(250,204,21,0.4)]",
        textBadge: "text-yellow-400 group-hover:text-yellow-300",
        faceSvg: `<svg class="w-16 h-16 filter drop-shadow-[0_0_12px_#facc15]" viewBox="0 0 100 100">
                    <polygon points="50,5 64,36 98,36 71,57 81,91 50,70 19,91 29,57 2,36 36,36" fill="#facc15" stroke="#fef08a" stroke-width="2"/>
                    <path d="M38 42 L40 45 L43 45 L41 47 L42 50 L38 48 L34 50 L35 47 L33 45 L36 45 Z" fill="#000"/>
                    <path d="M62 42 L64 45 L67 45 L65 47 L66 50 L62 48 L58 50 L59 47 L57 45 L60 45 Z" fill="#000"/>
                    <path d="M 42 56 Q 50 70 58 56 Z" fill="#000"/>
                  </svg>`
      },
      {
        colorName: "GREEN STAR",
        border: "border-emerald-500 group-hover:border-emerald-400",
        bgGlow: "bg-emerald-500/15 shadow-[0_0_30px_rgba(16,185,129,0.4)]",
        textBadge: "text-emerald-400 group-hover:text-emerald-300",
        faceSvg: `<svg class="w-16 h-16 filter drop-shadow-[0_0_12px_#10b981]" viewBox="0 0 100 100">
                    <polygon points="50,5 64,36 98,36 71,57 81,91 50,70 19,91 29,57 2,36 36,36" fill="#10b981" stroke="#a7f3d0" stroke-width="2"/>
                    <path d="M 32 46 Q 38 40 44 46" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round"/>
                    <path d="M 56 46 Q 62 40 68 46" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round"/>
                    <path d="M 44 58 Q 47 62 50 58 Q 53 62 56 58" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round"/>
                  </svg>`
      },
      {
        colorName: "PURPLE STAR",
        border: "border-purple-500 group-hover:border-purple-400",
        bgGlow: "bg-purple-500/15 shadow-[0_0_30px_rgba(168,85,247,0.4)]",
        textBadge: "text-purple-400 group-hover:text-purple-300",
        faceSvg: `<svg class="w-16 h-16 filter drop-shadow-[0_0_12px_#a855f7]" viewBox="0 0 100 100">
                    <polygon points="50,5 64,36 98,36 71,57 81,91 50,70 19,91 29,57 2,36 36,36" fill="#a855f7" stroke="#e9d5ff" stroke-width="2"/>
                    <ellipse cx="38" cy="46" rx="6" ry="8" fill="#000"/>
                    <ellipse cx="62" cy="46" rx="6" ry="8" fill="#000"/>
                    <circle cx="36" cy="43" r="2.5" fill="#fff"/>
                    <circle cx="60" cy="43" r="2.5" fill="#fff"/>
                    <circle cx="50" cy="60" r="4" fill="#000"/>
                  </svg>`
      },
      {
        colorName: "ORANGE STAR",
        border: "border-orange-500 group-hover:border-orange-400",
        bgGlow: "bg-orange-500/15 shadow-[0_0_30px_rgba(249,115,22,0.4)]",
        textBadge: "text-orange-400 group-hover:text-orange-300",
        faceSvg: `<svg class="w-16 h-16 filter drop-shadow-[0_0_12px_#f97316]" viewBox="0 0 100 100">
                    <polygon points="50,5 64,36 98,36 71,57 81,91 50,70 19,91 29,57 2,36 36,36" fill="#f97316" stroke="#fed7aa" stroke-width="2"/>
                    <path d="M 30 42 L 44 48 L 32 50 Z" fill="#000"/>
                    <path d="M 70 42 L 56 48 L 68 50 Z" fill="#000"/>
                    <line x1="42" y1="60" x2="58" y2="58" stroke="#000" stroke-width="3" stroke-linecap="round"/>
                  </svg>`
      }
    ];

    function setLuckMode(mode, e) {
      createRipple(e);
      luckMode = mode;
      document.getElementById('modeNormal').className = mode === 'normal' 
        ? "px-3 py-1.5 rounded-lg text-xs font-orbitron font-bold transition-all bg-red-500 text-white shadow-lg"
        : "px-3 py-1.5 rounded-lg text-xs font-orbitron font-bold text-red-400 hover:text-white transition-all";

      document.getElementById('modeVIP').className = mode === 'vip'
        ? "px-3 py-1.5 rounded-lg text-xs font-orbitron font-bold transition-all bg-red-500 text-white shadow-lg flex items-center gap-1"
        : "px-3 py-1.5 rounded-lg text-xs font-orbitron font-bold text-red-400 hover:text-white transition-all flex items-center gap-1";

      if (mode === 'vip') {
        document.getElementById('prob3').innerText = "60%";
        document.getElementById('prob2').innerText = "25%";
        document.getElementById('prob1').innerText = "10%";
        document.getElementById('prob0').innerText = "5%";
      } else {
        document.getElementById('prob3').innerText = "45%";
        document.getElementById('prob2').innerText = "25%";
        document.getElementById('prob1').innerText = "20%";
        document.getElementById('prob0').innerText = "10%";
      }

      resetStage();
    }

    function generatePrize() {
      const rand = Math.random() * 100;
      if (luckMode === 'vip') {
        if (rand < 60) return 3.00;
        if (rand < 85) return 2.00;
        if (rand < 95) return 1.00;
        return 0.00;
      } else {
        if (rand < 45) return 3.00;  // 45% -> $3.00
        if (rand < 70) return 2.00;  // 25% -> $2.00
        if (rand < 90) return 1.00;  // 20% -> $1.00
        return 0.00;                 // 10% -> $0.00
      }
    }

    function initStarValues() {
      starValues = Array.from({ length: TOTAL_STARS }, () => generatePrize());
      revealed = Array(TOTAL_STARS).fill(false);
    }

    function renderGrid() {
      const grid = document.getElementById('starGrid');
      grid.innerHTML = '';

      for (let i = 0; i < TOTAL_STARS; i++) {
        const val = starValues[i];
        const isRevealed = revealed[i];
        const starDef = BASIC_STARS[i % BASIC_STARS.length];

        const card = document.createElement('div');
        card.className = "star-capsule perspective-1000 w-full h-36 sm:h-44 cursor-pointer group";
        card.id = `card-${i}`;

        let textCol = 'text-yellow-400';
        let bgStyle = 'border-yellow-400/50 bg-yellow-400/10 shadow-[0_0_20px_rgba(250,204,21,0.2)]';
        
        if (val === 0) {
          textCol = 'text-slate-400';
          bgStyle = 'border-slate-800 bg-slate-950/80';
        } else if (val === 1) {
          textCol = 'text-emerald-400';
          bgStyle = 'border-emerald-500/50 bg-emerald-500/10 shadow-[0_0_20px_rgba(16,185,129,0.2)]';
        } else if (val === 2) {
          textCol = 'text-blue-400';
          bgStyle = 'border-blue-500/50 bg-blue-500/10 shadow-[0_0_20px_rgba(59,130,246,0.2)]';
        }

        card.innerHTML = `
          <div class="relative w-full h-full duration-500 transform-style-3d transition-transform" id="cardInner-${i}">
            <!-- Front Face: Basic Color Star -->
            <div class="absolute inset-0 w-full h-full rounded-3xl bg-slate-950/90 border-2 ${starDef.border} flex flex-col items-center justify-center backface-hidden shadow-2xl transition-all overflow-hidden ${starDef.bgGlow}">
              <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent pointer-events-none"></div>
              <div class="relative z-10 animate-float-star">
                ${starDef.faceSvg}
              </div>
              <span class="text-[10px] font-fredoka font-black ${starDef.textBadge} mt-2 uppercase tracking-widest">${starDef.colorName}</span>
            </div>

            <!-- Back Face: Reward Unlocked -->
            <div id="cardBack-${i}" class="absolute inset-0 w-full h-full rounded-3xl border-2 ${bgStyle} flex flex-col items-center justify-center backface-hidden rotate-y-180 shadow-2xl overflow-hidden">
              <span class="text-[9px] font-fredoka font-black text-slate-500 uppercase tracking-widest">UNLOCKED</span>
              <span class="font-orbitron text-3xl sm:text-4xl font-black ${textCol} my-1 filter drop-shadow">$${val.toFixed(2)}</span>
              <span class="text-[9px] font-fredoka font-bold ${val > 0 ? 'text-emerald-400' : 'text-slate-500'} tracking-widest uppercase">${val > 0 ? 'MARWAN REWARD' : 'ZERO WIN'}</span>
            </div>
          </div>
        `;

        card.addEventListener('mousemove', (e) => tiltCard(e, card, isRevealed));
        card.addEventListener('mouseleave', () => resetTilt(card));
        card.onclick = (e) => {
          createRipple(e);
          revealStar(i);
        };

        grid.appendChild(card);
      }
    }

    function tiltCard(e, card, isRevealed) {
      if (isRevealed) return;
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      card.style.transform = `perspective(1000px) rotateX(${-y / 5}deg) rotateY(${x / 5}deg) scale3d(1.05, 1.05, 1.05)`;
    }

    function resetTilt(card) {
      card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
    }

    function revealStar(idx) {
      if (revealed[idx]) return;

      playSound('tap');
      revealed[idx] = true;

      const inner = document.getElementById(`cardInner-${idx}`);
      const card = document.getElementById(`card-${idx}`);
      resetTilt(card);

      if (inner) inner.classList.add('rotate-y-180');

      const prize = starValues[idx];
      const starDef = BASIC_STARS[idx % BASIC_STARS.length];

      const rect = card.getBoundingClientRect();
      const originX = (rect.left + rect.width / 2) / window.innerWidth;
      const originY = (rect.top + rect.height / 2) / window.innerHeight;

      if (prize > 0) {
        spawnSparkles(originX, originY, prize === 3);
      }

      totalVault += prize;
      totalPicks++;
      if (prize > 0) winsCount++;
      if (prize === 3) jackpotsCount++;

      animateVaultCounter();
      updateDashboardStats();
      pushHistory(prize, starDef.colorName);

      setTimeout(() => {
        if (prize === 3) {
          playSound('jackpot');
          triggerCoinRain();
          openWinModal("JACKPOT!", "GRAND $3.00 WIN!", prize, "text-yellow-400", starDef.faceSvg);
        } else if (prize > 0) {
          playSound('win');
          const prizeWord = prize === 2 ? "ULTRA WIN $2.00!" : "STANDARD WIN $1.00!";
          openWinModal(prizeWord, "MARWAN PRIZE UNLOCKED", prize, prize === 2 ? "text-blue-400" : "text-emerald-400", starDef.faceSvg);
        } else {
          playSound('zero');
          openWinModal("NO PRIZE $0.00", "ZERO WIN THIS TIME", 0, "text-slate-400", starDef.faceSvg);
        }
      }, 400);
    }

    function autoPickStar(e) {
      if (e) createRipple(e);
      const unrevealed = [];
      revealed.forEach((r, i) => { if (!r) unrevealed.push(i); });

      if (unrevealed.length === 0) {
        resetStage();
        setTimeout(() => autoPickStar(), 300);
        return;
      }

      const randomIdx = unrevealed[Math.floor(Math.random() * unrevealed.length)];
      revealStar(randomIdx);
    }

    function resetStage(e) {
      if (e) createRipple(e);
      playSound('shuffle');
      initStarValues();

      const grid = document.getElementById('starGrid');
      grid.style.opacity = '0';
      grid.style.transform = 'scale(0.95)';
      grid.style.transition = 'all 0.2s ease-out';

      setTimeout(() => {
        renderGrid();
        grid.style.opacity = '1';
        grid.style.transform = 'scale(1)';
      }, 200);
    }

    function animateVaultCounter() {
      const vaultElem = document.getElementById('vaultBalance');
      const start = displayedVault;
      const end = totalVault;
      const duration = 500;
      const startTime = performance.now();

      function update(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        displayedVault = start + (end - start) * progress;
        vaultElem.innerText = `$${displayedVault.toFixed(2)}`;

        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          displayedVault = end;
          vaultElem.innerText = `$${end.toFixed(2)}`;
        }
      }

      requestAnimationFrame(update);
    }

    function updateDashboardStats() {
      document.getElementById('statPicks').innerText = totalPicks;
      document.getElementById('statWins').innerText = winsCount;
      document.getElementById('statJackpots').innerText = jackpotsCount;
    }

    function pushHistory(prize, starColorName) {
      const historyLog = document.getElementById('historyLog');
      history.unshift({ prize, color: starColorName });
      if (history.length > 5) history.pop();

      historyLog.innerHTML = history.map(item => {
        const val = item.prize;
        let style = "border-emerald-500/40 bg-emerald-950/30 text-emerald-400";
        let label = `+$${val.toFixed(2)}`;
        if (val === 0) {
          style = "border-slate-800 bg-black/60 text-slate-500";
          label = "$0.00";
        } else if (val === 3) {
          style = "border-yellow-500/60 bg-yellow-950/40 text-yellow-400 font-bold shadow-[0_0_15px_rgba(250,204,21,0.3)]";
          label = `+$${val.toFixed(2)} ⭐`;
        }

        return `
          <div class="flex items-center justify-between text-xs p-2.5 rounded-xl border ${style} font-orbitron transition-all">
            <span class="flex items-center gap-1.5">
              <span>⭐</span>
              ${item.color}
            </span>
            <span class="font-black">${label}</span>
          </div>
        `;
      }).join('');
    }

    function openWinModal(badgeText, title, prize, colorClass, faceSvg) {
      const modal = document.getElementById('winModal');
      const card = document.getElementById('winModalCard');
      document.getElementById('winBadgeText').innerText = badgeText;
      document.getElementById('modalTitle').innerText = title;
      document.getElementById('modalStarAvatar').innerHTML = faceSvg;

      const prizeElem = document.getElementById('modalPrize');
      prizeElem.innerText = `$${prize.toFixed(2)}`;
      prizeElem.className = `font-orbitron text-5xl font-black ${colorClass} filter drop-shadow-[0_0_15px_rgba(255,255,255,0.8)]`;

      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        card.classList.remove('scale-90');
        card.classList.add('scale-100');
      }, 10);
    }

    function closeWinModal(e) {
      if (e) createRipple(e);
      const modal = document.getElementById('winModal');
      const card = document.getElementById('winModalCard');
      card.classList.remove('scale-100');
      card.classList.add('scale-90');
      modal.classList.add('opacity-0');
      setTimeout(() => modal.classList.add('hidden'), 300);
    }

    function togglePaytableModal(e) {
      if (e) createRipple(e);
      document.getElementById('paytableModal').classList.toggle('hidden');
    }

    function spawnSparkles(x, y, isBig) {
      if (typeof confetti === 'function') {
        confetti({
          particleCount: isBig ? 90 : 40,
          spread: isBig ? 100 : 60,
          origin: { x, y },
          colors: ['#ef4444', '#3b82f6', '#facc15', '#10b981', '#a855f7', '#f97316']
        });
      }
    }

    function triggerCoinRain() {
      if (typeof confetti !== 'function') return;
      const duration = 2 * 1000;
      const end = Date.now() + duration;

      (function frame() {
        confetti({
          particleCount: 6,
          angle: 60,
          spread: 55,
          origin: { x: 0 },
          colors: ['#ef4444', '#3b82f6', '#facc15']
        });
        confetti({
          particleCount: 6,
          angle: 120,
          spread: 55,
          origin: { x: 1 },
          colors: ['#10b981', '#a855f7', '#f97316']
        });

        if (Date.now() < end) requestAnimationFrame(frame);
      }());
    }

    function initLaserCanvas() {
      const canvas = document.getElementById('laserCanvas');
      const ctx = canvas.getContext('2d');
      let w = (canvas.width = window.innerWidth);
      let h = (canvas.height = window.innerHeight);

      window.addEventListener('resize', () => {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
      });

      const particles = Array.from({ length: 45 }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        size: Math.random() * 2.5 + 0.5,
        speedY: Math.random() * 0.4 + 0.1,
        alpha: Math.random() * 0.6 + 0.2,
        color: ['#ef4444', '#3b82f6', '#facc15', '#10b981', '#a855f7', '#f97316'][Math.floor(Math.random() * 6)]
      }));

      function loop() {
        ctx.clearRect(0, 0, w, h);
        particles.forEach(p => {
          p.y -= p.speedY;
          if (p.y < 0) p.y = h;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.globalAlpha = p.alpha;
          ctx.shadowBlur = 8;
          ctx.shadowColor = p.color;
          ctx.fill();
        });
        ctx.globalAlpha = 1;
        requestAnimationFrame(loop);
      }
      loop();
    }

    window.onload = function() {
      initStarValues();
      renderGrid();
      initLaserCanvas();
    };
  </script>
