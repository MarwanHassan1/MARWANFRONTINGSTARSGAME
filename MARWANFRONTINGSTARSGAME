<!DOCTYPE html>
<html lang="en" class="h-full bg-black text-slate-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MARWANFRONTINGSTARSGAME - Basic Colors Arcade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Fredoka:wght@500;600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            orbitron: ['Orbitron', 'sans-serif'],
            fredoka: ['Fredoka', 'cursive'],
            sans: ['Rajdhani', 'sans-serif'],
          },
          animation: {
            'gold-shimmer': 'goldShimmer 3s linear infinite',
            'float-star': 'floatStar 3s ease-in-out infinite',
            'glow-pulse': 'glowPulse 1.5s ease-in-out infinite alternate',
          },
          keyframes: {
            goldShimmer: {
              '0%': { backgroundPosition: '-200% 0' },
              '100%': { backgroundPosition: '200% 0' },
            },
            floatStar: {
              '0%, 100%': { transform: 'translateY(0px) rotate(0deg)' },
              '50%': { transform: 'translateY(-8px) rotate(3deg)' },
            },
            glowPulse: {
              '0%': { boxShadow: '0 0 10px rgba(255, 255, 255, 0.2)' },
              '100%': { boxShadow: '0 0 30px rgba(255, 255, 255, 0.6)' }
            }
          }
        }
      }
    }
  </script>

  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #050508; }
    ::-webkit-scrollbar-thumb { background: #ef4444; border-radius: 9999px; }

    .gold-metallic-text {
      background: linear-gradient(135deg, #fff3c4 0%, #f59e0b 35%, #ef4444 70%, #fef08a 100%);
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: goldShimmer 4s linear infinite;
    }

    .obsidian-glass {
      background: rgba(13, 15, 23, 0.88);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8);
    }

    .cyber-btn {
      background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
      box-shadow: 0 0 20px rgba(239, 68, 68, 0.4);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
    }
    .cyber-btn:hover {
      background: linear-gradient(135deg, #f87171 0%, #dc2626 100%);
      box-shadow: 0 0 35px rgba(239, 68, 68, 0.7);
      transform: translateY(-2px);
    }

    .perspective-1000 { perspective: 1000px; }
    .transform-style-3d { transform-style: preserve-3d; }
    .backface-hidden { backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }

    .star-capsule {
      transition: transform 0.2s ease, box-shadow 0.25s ease;
      transform-style: preserve-3d;
    }

    .ripple-effect {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.6);
      transform: scale(0);
      animation: ripple 0.5s linear;
      pointer-events: none;
    }
    @keyframes ripple {
      to { transform: scale(3.5); opacity: 0; }
    }
  </style>
</head>
<body class="h-full bg-black font-sans text-slate-100 flex flex-col justify-between overflow-x-hidden relative selection:bg-red-500 selection:text-white">

